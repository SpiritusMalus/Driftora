# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# docs live in the Obsidian vault (itself outside git) — keep this repo code-only.
# No Markdown is tracked here. To keep a specific file, add an exception, e.g.
# `!README.md`, below this line.
*.md
# Exception: the repo README is the one tracked doc at the root (every git
# project should carry one).
!README.md
# Exception: the legal documents are product artifacts (rendered in-app and
# hosted at a public URL for the stores), so they ARE tracked here.
!legal/PRIVACY_POLICY.md
!legal/TERMS_OF_USE.md
# Exception: turning payments on is a sequence of steps against a live shop and
# a live server — the one runbook whose absence costs real money to rediscover.
!docs/billing-setup.md
# Exception: the store listing (descriptions, Data-safety/rating answers, the
# publication checklist) is a product artifact paired with docs/store/ assets.
!docs/store-listing.md
# Exception: rebuilding the Open Food Facts snapshot is a sequence of steps
# against a 1.28 GB upstream dump and the live server — the numbers in it
# (what the dump does and does not contain) cost a day to rediscover.
!docs/off-snapshot.md

.claude/
dist.stale.*

# IDE project files (JetBrains) — machine-local, never part of the app.
.idea/
*.iml

# Anchored to repo root: ignore the top-level nested mockup / handoff-ref dirs
# (duplicate UI, .dc.html, *-frame.jsx — never part of the RN build) WITHOUT
# matching nested package dirs like modules/.../com/driftora/ (macOS git is
# case-insensitive). The dir is named HealthRoutine/ on disk today; /Driftora/
# future-proofs the rebrand rename — keep both.
/Driftora/
/HealthRoutine/

# Снимок Open Food Facts — артефакт деплоя, не содержимое репозитория
# (данные ODbL, репозиторий публичный; готовится npm run import:off)
server/data/off-ru.jsonl
server/data/off-ru-brands.txt
server/data/off-barcodes.bin
server/data/off-barcodes.names

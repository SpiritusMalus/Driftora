# === Food-parse service env (server-side only — NEVER ship keys to the app) ===

# OpenRouter API key (sk-or-v1-…) — vision + text identification. Required.
# OpenRouter is OpenAI-compatible and reachable from EEA hosts. Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug (defaults to google/gemini-3.5-flash). Must be vision-capable for
# the photo route. Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-3.5-flash
# Optional stronger model for low-confidence escalation (e.g. google/gemini-3.1-pro-preview).
# Leave unset to disable escalation.
OPENROUTER_PRO_MODEL=
# Optional base URL override (defaults to https://openrouter.ai/api/v1).
OPENROUTER_BASE_URL=

# USDA FoodData Central key — nutrition numbers (free). Required: US numbers
# AND the broad RU fallback (when the curated RU table misses, the item is
# re-queried by its English name). Get one at
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Optional paid text fallback (API Ninjas). Leave unset to disable.
APININJAS_KEY=

# Optional FatSecret Platform API (extra free-text fallback). NOTE: the free
# Basic tier is US-data + English-only; RU localization is paid Premier — so
# this does NOT close the RU gap (USDA-by-EN-name + OFF search do). OAuth2
# client-credentials key pair; both must be set to enable. Register an app at
# https://platform.fatsecret.com/
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Default nutrition region when the request omits one: US or RU (default US).
DEFAULT_REGION=US

# Port to listen on (default 8787).
PORT=8787

# Optional: static bearer token required on every request (Authorization:
# Bearer <token>). Leave unset to disable auth. Not tied to any user identity.
# The app supplies it from its EXPO_PUBLIC_FOOD_API_TOKEN build-time env var —
# only enable once installed builds carry the token, or they fall back offline.
# The SHARED food base — the dishes no composition table carries (шаурма,
# хачапури, домашние сырники), contributed by the app and searched by name.
# Path to its JSONL store. UNSET = the feature is OFF: nothing is stored, nothing
# is served, and the provider chain is exactly what it was without it. What the
# file holds is a food name, a region and per-100 g macros — never an install id,
# an address or a time, so a row cannot be traced to whoever contributed it.
COMMUNITY_FOODS_PATH=

APP_TOKEN=

# Optional: restrict CORS to a single origin. Leave unset to allow any origin.
ALLOWED_ORIGIN=

# === Per-IP rate limits (abuse / Gemini-quota guard) ===
# All optional; values are positive integers. Keying is per-IP behind Caddy
# (trust proxy = 1); IPv6 is grouped by /64. Defaults are generous on purpose —
# per-IP is coarse for mobile (CGNAT shares one IP across many users).
# Global burst guard: max requests per IP per minute, across all routes (default 30).
RL_BURST_PER_MIN=30
# Daily cap per IP on POST /food/parse (text) (default 300).
RL_TEXT_PER_DAY=300
# Daily cap per IP on POST /food/parse-photo (vision — pricier, tighter) (default 100).
RL_PHOTO_PER_DAY=100

# === Per-install daily AI quota (the CGNAT-safe metering layer) ===
# Requests per install per UTC day across ALL AI parse routes (food text/photo/
# audio + workout). Keyed by the client's random X-Install-Id header (no account,
# no device identifier); clients without the header share an ip-keyed fallback.
# The id is client-generated and spoofable — this meters honest apps and feeds
# the /metrics usage histogram (future free-tier / subscription sizing); the
# RL_* per-IP caps above remain the abuse backstop. 0 disables. Default 30.
AI_PER_INSTALL_PER_DAY=30
# Same, for installs with an active subscription (default 100). A fair-use
# ceiling, not a meter anyone eating food should feel. Both caps live here rather
# than in a build so they can be raised by a restart — and note that RAISING is
# free while LOWERING the paid cap on people who already bought it is not.
AI_PER_INSTALL_PER_DAY_PAID=100

# === Billing (all optional — unset means "free tier for everyone") ===
# Nothing below is required to run the service. With none of it set, purchases
# simply cannot be registered and every install gets AI_PER_INSTALL_PER_DAY.

# Where verified entitlements persist (install ↔ purchase bindings). Must survive
# deploys: losing this file silently downgrades everyone who paid. Only a SHA-256
# of each purchase token is stored, never the token itself.
ENTITLEMENTS_PATH=/opt/healthroutine-food/data/entitlements.jsonl

# --- Google Play subscriptions ---
# Service-account JSON (inline, or a path to the file) with Play Developer API
# access. Unset = the store adapter is off. Create it in Google Cloud, then grant
# it access in Play Console → Users and permissions.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Package to verify purchases against (default com.driftora.app).
ANDROID_PACKAGE_NAME=com.driftora.app

# --- ЮKassa direct sales ---
# Shop id + secret key from the ЮKassa dashboard. BOTH must be set to enable.
# Then point a payment.succeeded webhook at
# https://<host>/billing/yookassa/webhook — that endpoint is authenticated by
# ЮKassa's source-IP allowlist, not by APP_TOKEN, and it re-reads every payment
# through the API rather than trusting the notification body.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where issued licence keys persist. Same durability requirement as entitlements.
LICENSES_PATH=/opt/healthroutine-food/data/licenses.jsonl

# Prices in roubles, per plan (defaults 199 / 1990). A value that is not a
# positive number is IGNORED rather than fatal — a typo here must not take food
# parsing down, and the default is a defensible price rather than zero.
BILLING_PRICE_MONTHLY=199
BILLING_PRICE_YEARLY=1990
# Absolute origin the payer's browser comes back to when the purchase was started
# by the APP (ЮKassa return_url). Unset falls back to the request's own host,
# which is correct behind Caddy but pins down badly if this ever sits behind
# something that rewrites Host. The web purchase page sends its own return_url.
BILLING_PUBLIC_URL=https://food.family-pie.ru
# Where /billing/pay redirects — the one page that actually sells. It lives on
# the site, so the price, the refund rules and the seller's details have a single
# home instead of two that drift apart.
BILLING_SALES_URL=https://family-pie.ru/driftora/subscription
# Origins allowed to drive a purchase from a browser: CORS for /billing/*, and
# the allowlist a return_url must match. One list, because both answer the same
# question — "is this page ours?" — and two would drift until one of them let a
# stranger's page collect our buyers. Comma-separated.
BILLING_WEB_ORIGINS=https://family-pie.ru,https://www.family-pie.ru
# 1 = send a 54-ФЗ receipt with every payment, which also makes the buyer's
# email mandatory on the purchase page. Turn this on when a cash register is
# attached to the shop in ЮKassa (such a shop REJECTS a payment without a
# receipt); leave it off when receipts are issued elsewhere, or they double.
BILLING_RECEIPT=0
# VAT code for the receipt line. 1 = «без НДС» — right for ИП on УСН.
BILLING_VAT_CODE=1
# --- Вход через Google (привязка подписки к аккаунту) ---
# Client id'ы, которым может быть адресован ID-токен, через запятую. Пусто =
# вход по аккаунту выключен, подписка остаётся ключом.
#
# ВАЖНО: в `aud` Google кладёт WEB client id даже при входе с Android — так
# устроен их SDK, и это самая частая причина «токен не принимается». Android-id
# указывать не обязательно, но не вредно.
#
# Секрет Web-клиента здесь НЕ НУЖЕН и не должен появляться: мы проверяем
# ID-токен подписью Google, а не обмениваем код. Если он где-то потребовался —
# значит выбран не тот поток.
GOOGLE_CLIENT_IDS=627245153089-9prong5icehhvnimdrlaberfse7jm5ls.apps.googleusercontent.com

# Daily cap per IP on POST /billing/register (default 120). Its own bucket so
# launch-time purchase checks never eat into anyone's meal parses.
RL_BILLING_PER_DAY=120

# Reasoning throttle for typed-TEXT LLM calls (identify text / workout text /
# label translate). The model's reasoning is mandatory upstream and can't be
# disabled, but its budget can: 'low' (default) answers ~3-5 s vs 13-27 s at
# full effort with the same parsed items (measured 2026-07-21 on the prod
# prompt). Vision and the estimator keep full effort. 'off' sends no reasoning
# field. Values: low | medium | high | off.
REASONING_EFFORT_TEXT=low

# Same throttle for the media paths (photo identify, package-label read, voice
# meal, workout photo/audio). Label misreads at low effort are caught by the
# cross-check (two independent parses must agree), so the failure mode is «no
# label», never wrong numbers. Values: low | medium | high | off.
REASONING_EFFORT_MEDIA=low

# OpenRouter upstreams to EXCLUDE for the audio route (comma-separated slugs).
# Default 'google-vertex'. Measured 2026-08-12: OpenRouter serves one model slug
# from several upstreams and they do not handle `input_audio` alike — on the same
# clip, Google AI Studio parsed 5/5 while Vertex produced an unparseable 6126-token
# decode loop 3/3 (different PROMPT token counts for identical audio give it away).
# Unpinned, ~a third of voice notes landed there and returned 503. Text is healthy
# on both, so only audio narrows its routing. Empty string = no exclusion (re-test
# by restart, no deploy).
OPENROUTER_AUDIO_IGNORE_PROVIDERS=google-vertex
